{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal Noise",
  "mainBinaryName": "signal-noise",
  "version": "0.1.0",
  "identifier": "games.signalnoise.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build -- --dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Signal / Noise",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "A story about reading hardware, and people.",
    "longDescription": "Signal / Noise is a story game in which you write C for an emulated microcontroller, the K28. Build it with the bundled compiler, watch every pin on a logic analyser, debug it line by line (backwards too), and hand it in to a checker that runs hidden seeds.",
    "copyright": "Signal / Noise",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sdk/": "sdk/",
      "resources/zig/": "zig/"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
